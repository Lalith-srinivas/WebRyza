rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identifies partner login accounts via their deterministic synthetic email domain
    function isPartner() {
      return isAuthenticated() && 
        request.auth.token.email.matches('.*@partner\\.webryza\\.in$');
    }

    // WebRyza Administrator: Any authenticated staff member who is not a partner
    function isAdmin() {
      return isAuthenticated() && !isPartner();
    }

    // Helper to check if a partner owns a record via their authUid in wedding_partners
    function isPartnerRecordOwner(partnerId) {
      return isPartner() && 
        partnerId != null && 
        partnerId != '' &&
        exists(/databases/$(database)/documents/wedding_partners/$(partnerId)) &&
        get(/databases/$(database)/documents/wedding_partners/$(partnerId)).data.authUid == request.auth.uid;
    }

    // ==================================================
    // 1. WebRyza Existing Projects Collection
    // ==================================================
    match /projects/{projectId} {
      allow read, write: if isAdmin();
    }

    // ==================================================
    // 2. Wedding Partners Collection
    // ==================================================
    match /wedding_partners/{partnerId} {
      // Administrators have full control
      allow read, write: if isAdmin();

      // Partners can read only their own partner profile established by their authUid
      allow get: if isPartner() && resource.data.authUid == request.auth.uid;

      // Public registration form can read active partner info to display shop name
      // and verify active referral status
      allow get: if resource.data.isActive == true;
    }

    // ==================================================
    // 3. Partner Usernames Mapping Collection
    // ==================================================
    match /partner_usernames/{username} {
      // Administrators have full control (manage mappings, release stale usernames)
      allow read, write: if isAdmin();

      // Public / partner portal login lookup
      allow get: if true;
    }

    // ==================================================
    // 4. Wedding Cards Collection
    // ==================================================
    match /wedding_cards/{cardId} {
      // Administrators have full control
      allow read, write: if isAdmin();

      // Partners can read only the wedding projects that belong to their verified shop
      allow read: if isPartnerRecordOwner(resource.data.partnerId);

      // Secure public submission from cards.webryza.in registration form:
      // Validates required fields, enforces minimum ₹1,500 charge,
      // and guarantees initial status is 'confirmed', with 0 payments received.
      allow create: if 
        request.resource.data.amountCharged is number &&
        request.resource.data.amountCharged >= 1500 &&
        request.resource.data.brideName is string &&
        request.resource.data.brideName.size() > 0 &&
        request.resource.data.groomName is string &&
        request.resource.data.groomName.size() > 0 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() > 0 &&
        request.resource.data.status == 'confirmed' &&
        request.resource.data.paymentStatus == 'pending' &&
        request.resource.data.amountReceivedByWebryza == 0 &&
        (
          (request.resource.data.amountCharged < 2000 && request.resource.data.webryzaShare == 1000) ||
          (request.resource.data.amountCharged >= 2000 && request.resource.data.webryzaShare == 1500)
        );
    }

    // ==================================================
    // 5. Wedding Payments Collection
    // ==================================================
    match /wedding_payments/{paymentId} {
      // Only administrators can add, edit, or delete payment records
      allow read, write: if isAdmin();

      // Partners can read recorded payment receipts for their own projects only
      allow read: if isPartnerRecordOwner(resource.data.partnerId);
    }
  }
}
